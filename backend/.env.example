# Скопируйте в .env и подставьте свои значения.
# Docker (из корня репозитория): docker compose --env-file backend/.env up --build
# DB_HOST в .env может оставаться localhost — в compose для сервиса app он переопределяется на имя контейнера БД.
PORT=4200

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

OPENWEATHER_API_KEY=
